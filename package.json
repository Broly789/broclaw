{
  "name": "bro-claw",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present",
    "web:start": "npm start -w @broclaw/web"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}