{
  "name": "bro-claw",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "bro-claw",
      "workspaces": [
        "apps/*",
        "packages/*"
      ],
      "engines": {
        "node": ">=18.0.0"
      }
    },
    "apps/web": {
      "name": "@broclaw/web",
      "version": "0.1.0",
      "dependencies": {
        "@broclaw/shared": "*"
      }
    },
    "node_modules/@broclaw/config": {
      "resolved": "packages/config",
      "link": true
    },
    "node_modules/@broclaw/shared": {
      "resolved": "packages/shared",
      "link": true
    },
    "node_modules/@broclaw/web": {
      "resolved": "apps/web",
      "link": true
    },
    "packages/config": {
      "name": "@broclaw/config",
      "version": "0.1.0"
    },
    "packages/shared": {
      "name": "@broclaw/shared",
      "version": "0.1.0"
    }
  }
}
